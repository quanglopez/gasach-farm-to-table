# Gasach farm-to-table — Cloudflare Pages / local dev template.
# Copy to .env and fill values. NEVER commit real .env with secrets.
# Values below are intentionally empty.

# Supabase project URL (public, build-time for Vite)
VITE_SUPABASE_URL=

# Supabase publishable (anon) key (public, build-time for Vite)
VITE_SUPABASE_PUBLISHABLE_KEY=

# Supabase project ID (currently unused in src; kept for tooling)
VITE_SUPABASE_PROJECT_ID=
